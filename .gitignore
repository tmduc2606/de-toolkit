# ===========================================================================
# Virtual environments — a single top-level .venv is created by `uv sync`.
# ===========================================================================
.venv/
venv/
env/
ENV/

# ===========================================================================
# Secrets & local configuration — never commit anything in this block.
# dbt profiles contain live warehouse credentials; only profiles.example.yml
# (with env_var placeholders) may be committed.
# ===========================================================================
.env
.env.*
!.env.example
**/profiles.yml
**/profiles_bak.yml
**/.user.yml
*.pem
*.key
*.p12
airflow.db
fernet_key

